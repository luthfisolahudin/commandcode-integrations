{
  "name": "@luthfisolahudin/commandcode-integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "CommandCode model catalog integration for OpenCode and Pi with live model discovery",
  "main": "./adapters/opencode/src/index.ts",
  "exports": {
    ".": "./adapters/opencode/src/index.ts"
  },
  "pi": {
    "extensions": [
      "./adapters/pi/src/index.ts"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "check": "node scripts/verify-upstream.ts && pnpm run typecheck && pnpm run test:packages && pnpm run check:boundaries && pnpm run check:catalog && pnpm run report -- --check && pnpm run doctor",
    "typecheck": "tsc -p tsconfig.json",
    "test:packages": "pnpm -r test",
    "check:boundaries": "node packages/dev/cli/src/commands/boundaries.ts",
    "check:catalog": "node packages/dev/cli/src/commands/check-catalog.ts",
    "conformance": "pnpm --filter @luthfisolahudin/ai-integrations-conformance test",
    "report": "node packages/dev/cli/src/commands/report.ts",
    "doctor": "node packages/dev/cli/src/commands/doctor.ts",
    "probe:effort": "node packages/dev/cli/src/commands/probe-effort.ts",
    "probe:routes": "node packages/dev/cli/src/commands/probe-routes.ts",
    "pricing": "node packages/dev/cli/src/commands/pricing.ts",
    "quota": "node packages/dev/cli/src/commands/quota.ts",
    "verify:live": "node verify-live.ts",
    "sync:upstream": "node scripts/sync-upstream.ts",
    "report:check": "node packages/dev/cli/src/commands/report.ts --check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@opencode/ai": "catalog:",
    "@opencode/plugin": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0+sha512-Zv2CeO4ok1zpUXktNDZ/869cQyonVkRYIwKVM4NbjaUpu+C+UTCv1W7QcT+4eJ5Hutgtk71a4v5UsVVi1idu8A==",
      "onFail": "error"
    }
  }
}
